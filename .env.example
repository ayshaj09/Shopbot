# Copy to .env for local runs. On Hugging Face, add these as Space Secrets instead.
# Never commit the real values.

ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
ADMIN_TOKEN=choose-a-long-random-string

# Optional
# MODEL=anthropic:claude-haiku-5-5
# MAX_TOKENS=1024
# EFFORT=low                 # low | medium | high
# TEMPERATURE=none           # claude-haiku-5-5 rejects a custom temperature; leave as none
# STORE_NAME=Bazaar Lane
# CORS_ORIGINS=https://your-site.vercel.app   # default * (any site)
# RATE_LIMIT_PER_MIN=30      # per user_id; 0 turns it off
